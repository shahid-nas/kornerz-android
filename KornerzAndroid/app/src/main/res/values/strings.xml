<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        app_name is overridden by the dev/prod flavor's resValue in
        app/build.gradle.kts. This default keeps the resource reference
        resolvable for tooling and previews.
    -->
    <string name="app_name">Kornerz</string>

    <!--
        The notification channel's id. It must match
        `KornerzFcmService.CHANNEL_ID` — the manifest's
        `default_notification_channel_id` meta-data resolves this string,
        and the channel itself is created under that id in
        `MainActivity.onCreate`.
    -->
    <string name="kornerz_notification_channel_id" translatable="false">kornerz_notifications</string>
</resources>
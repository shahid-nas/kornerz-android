<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Legacy launcher (mipmap-hdpi/etc.) is unused at runtime — adaptive
        icons cover every device we support (API 26+). These PNGs are
        placeholders so the launcher still resolves `@mipmap/ic_launcher` if
        something falls back to a non-adaptive lookup. The build does
        not require them to ship; they exist so the resource reference
        in the manifest is unambiguous.
    -->
</resources>
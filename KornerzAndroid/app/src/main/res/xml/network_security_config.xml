<?xml version="1.0" encoding="utf-8"?>
<!--
  The video-call token handshake connects to `ws://ws.kornerz.com:80/`,
  which is plain TCP on port 80. Since targetSdk 28+, cleartext traffic
  is blocked by default, so the domain is explicitly exempted here.
  Every other destination (REST API, IPFS, Firebase) stays HTTPS-only.

  This config lives in `main` (not a flavor) because both the dev and
  prod flavors use the same token service; scoping it to `dev` made
  the prod release build fail the socket handshake with
  "CLEARTEXT communication to ws.kornerz.com not permitted".
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">ws.kornerz.com</domain>
    </domain-config>
</network-security-config>
